# ═══════════════════════════════════════════════════════════════
#  UstaTop Backend — Server uchun .env namunasi
#  Bu faylni .env ga nusxalab, qiymatlarni to'ldiring
# ═══════════════════════════════════════════════════════════════

PORT=5000
NODE_ENV=production

# Database — Neon.tech dan olinadi (bepul PostgreSQL)
# https://neon.tech → New Project → Connection String
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/ustatop?sslmode=require

# JWT — ixtiyoriy uzun maxfiy kalit (kamida 32 belgi)
JWT_SECRET=juda_uzun_va_murakkab_maxfiy_kalit_bu_yerni_ozgartiring
JWT_EXPIRES_IN=7d

# SMS — Eskiz (real SMS uchun)
# https://notify.eskiz.uz → API kalitlar
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=sizning@email.com
ESKIZ_PASSWORD=eskiz_api_parolingiz

# Fayl saqlash
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Admin
ADMIN_PHONE=+998901234567
ADMIN_SECRET_KEY=juda_maxfiy_admin_kalitingiz

# CORS — frontend URL (Vercel dan olinadi)
CORS_ORIGIN=https://ustatop.vercel.app
FRONTEND_URL=https://ustatop.vercel.app

# Payme To'lov Tizimi
# https://merchant.payme.uz → Kassa → Kalitlar
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_SECRET_KEY=
PAYME_TEST_MODE=false
PAYME_REGISTRATION_AMOUNT=29000
